#include <windows.h>
#include "version.h"

#define STRINGIFY(x) #x
#define TOSTRING(x) STRINGIFY(x)

VS_VERSION_INFO VERSIONINFO
FILEVERSION     WW_VERSION_MAJOR, WW_VERSION_MINOR, 0, 0
PRODUCTVERSION  WW_VERSION_MAJOR, WW_VERSION_MINOR, 0, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef RELEASE
FILEFLAGS       0
#else
FILEFLAGS       VS_FF_DEBUG
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "ww"
            VALUE "FileDescription",  "ww - 窗口工作区切换器"
            VALUE "FileVersion",      TOSTRING(WW_VERSION_MAJOR) "." TOSTRING(WW_VERSION_MINOR)
            VALUE "InternalName",     "ww"
            VALUE "LegalCopyright",   ""
            VALUE "OriginalFilename", "ww.exe"
            VALUE "ProductName",      "ww"
            VALUE "ProductVersion",   TOSTRING(WW_VERSION_MAJOR) "." TOSTRING(WW_VERSION_MINOR)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 0x04B0
    END
END
